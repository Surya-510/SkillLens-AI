# ==========================================
# SkillLens AI - Git Ignore
# ==========================================

# =========================
# FRONTEND
# =========================

skilllens-ai frontend/node_modules/
skilllens-ai frontend/dist/
skilllens-ai frontend/.env
skilllens-ai frontend/.env.local
skilllens-ai frontend/.env.production


# =========================
# BACKEND
# =========================

skilllens-ai backend/target/
skilllens-ai backend/uploads/

# Spring Boot logs
skilllens-ai backend/*.log
skilllens-ai backend/logs/


# =========================
# ENVIRONMENT / SECRETS
# =========================

.env
.env.*
!.env.example

application-local.properties
application-local.yml

# If credentials are inside these files
skilllens-ai backend/src/main/resources/application-local.properties
skilllens-ai backend/src/main/resources/application-local.yml


# =========================
# JAVA / MAVEN
# =========================

*.class
*.jar
*.war

.mvn/


# =========================
# NODE
# =========================

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =========================
# IDE
# =========================

.idea/
.vscode/
*.iml


# =========================
# OS
# =========================

.DS_Store
Thumbs.db


# =========================
# TEMPORARY FILES
# =========================

*.tmp
*.temp
*.swp


# =========================
# BUILD / GENERATED FILES
# =========================

**/target/
**/node_modules/
**/dist/